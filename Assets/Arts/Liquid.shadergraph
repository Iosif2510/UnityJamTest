    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "LiquidFoam",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// IsometricFoamyWater foam: scrolling Gradient Noise mask and sqrt(Simple Noise) detail.\n// Perspective depth only: compare scene and liquid in linear eye-space units.\nfloat sceneEyeDepth = LinearEyeDepth(SceneDepthRaw, _ZBufferParams);\nfloat surfaceEyeDepth = -TransformWorldToView(WorldPosition).z;\nfloat contactDepth = max(sceneEyeDepth - surfaceEyeDepth, 0.0);\nfloat width = max(FoamWidth, 0.00001) * (1.0 + Motion * 2.0);\n// Retain the liquid's surface-edge placement as well as the perspective contact fade.\nfloat depthFade = max(max(Depth, 0.0) / width, contactDepth / width);\nfloat cutoff = max(depthFade * max(FoamCutoff, 0.0001), 0.0001);\nfloat mask = smoothstep(cutoff * 0.8, cutoff, GradientNoise);\nfloat detail = sqrt(saturate(DetailNoise));\nFoam = saturate(mask * detail * saturate(FoamStrength)) * step(0.0, Depth) * step(0.00001, FoamWidth);\nColor = lerp(BaseColor, FoamColor, Foam);"
}

