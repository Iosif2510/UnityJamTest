--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: df95b568cc5840e42bd55130ca5b7d73, type: 3}
  m_Name: DialogueCatalog
  m_EditorClassIdentifier: Assembly-CSharp::PotionShop.Data.DialogueCatalog
  lines:
  - key: sym_DIS_01
    kind: 0
    diseaseId: DIS_01
    conditionText: "\uC9C8\uBCD1\uC774 DIS_01"
    targetLength: "200\uC790 \uB0B4\uC678"
    text: "\uC548\uB155\uD558\uC138\uC694. \uC624\uB294 \uAE38\uC5D0 \uAD11\uC7A5\uC5D0\uC11C
      \uCD95\uC81C \uCC9C\uB9C9\uC744 \uCE58\uB290\uB77C \uAE38\uC774 \uB2E4 \uB9C9\uD600\uC11C
      \uD55C\uCC38 \uB3CC\uC544\uC654\uC5B4\uC694. \uADF8\uAC74 \uADF8\uB807\uACE0,
      <sym>\uAC78\uC5B4\uAC00\uBA74 \uADF8\uB9BC\uC790\uAC00 \uD55C\uCC38 \uC788\uB2E4\uAC00
      \uB530\uB77C\uC640\uC694</sym>. \uCC98\uC74C\uC5D4 \uB208\uC774 \uCE68\uCE68\uD574\uC11C
      \uADF8\uB7F0 \uC904 \uC54C\uC558\uC8E0. <sym>\uD574 \uC9C8 \uBB34\uB835\uC774\uBA74
      \uB354 \uC2EC\uD574\uC11C</sym> \uC800\uB141 \uC7A5 \uBCF4\uB7EC \uB098\uAC00\uAE30\uAC00
      \uBB34\uC11C\uC6CC\uC694. \uC5B4\uC81C\uB294 <sym>\uB4A4\uB97C \uB3CC\uC544\uBD24\uB294\uB370
      \uBC14\uB2E5\uC5D0 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uB354\uB77C\uACE0\uC694</sym>.
      \uC18C\uB9AC \uC9C0\uB97C \uBED4\uD588\uC5B4\uC694. \uC606\uC9D1 \uC544\uC8FC\uBA38\uB2C8\uAC00
      \uB180\uB77C\uC11C \uB6F0\uC5B4\uB098\uC624\uC168\uB2E4\uB2C8\uAE4C\uC694."
  - key: sym_DIS_02
    kind: 0
    diseaseId: DIS_02
    conditionText: "\uC9C8\uBCD1\uC774 DIS_02"
    targetLength: "200\uC790 \uB0B4\uC678"
    text: "\uC544, \uC548\uB155\uD558\uC138\uC694, \uD558\uC138\uC694. \uBC29\uAE08
      \uB4E4\uC73C\uC168\uC8E0? \uC774\uAC83 \uB54C\uBB38\uC5D0 \uC654\uC5B4\uC694.
      <sym>\uC81C\uAC00 \uB9D0\uC744 \uD558\uBA74 \uB05D\uC774 \uB450 \uBC88\uC529
      \uB3CC\uC544\uC640\uC694</sym>. \uC2DC\uC7A5\uC5D0\uC120 \uC2DC\uB044\uB7EC\uC6CC\uC11C
      \uC798 \uBAA8\uB974\uB294\uB370, <sym>\uC870\uC6A9\uD55C \uB370 \uAC00\uBA74
      \uD6E8\uC52C \uD06C\uAC8C \uB4E4\uB824\uC694</sym>. \uADF8\uB798\uC11C \uC694\uC998\uC740
      \uCC3D\uBB38\uC744 \uC5F4\uC5B4 \uB193\uACE0 \uC790\uC694. \uC606\uC9D1 \uAC1C\uAC00
      \uC9D6\uC5B4 \uC918\uC57C \uC880 \uB0AB\uAC70\uB4E0\uC694. \uC81C\uC77C \uACE4\uB780\uD55C
      \uAC74 <sym>\uD63C\uC7A3\uB9D0\uAE4C\uC9C0 \uB2E4 \uB418\uB3CC\uC544\uC628\uB2E4\uB294
      \uAC70\uC608\uC694</sym>. \uD63C\uC790 \uC788\uC5B4\uB3C4 \uD63C\uC790\uAC00
      \uC544\uB2CC \uAC83 \uAC19\uC544\uC694."
  - key: sym_DIS_03
    kind: 0
    diseaseId: DIS_03
    conditionText: "\uC9C8\uBCD1\uC774 DIS_03"
    targetLength: "200\uC790 \uB0B4\uC678"
    text: "\uC624\uB294 \uAE38\uC5D0 \uBE75\uC9D1 \uC904\uC774 \uC5B4\uCC0C\uB098
      \uAE38\uB358\uC9C0\uC694. \uAC70\uAE30 \uD638\uB450\uBE75\uC774 \uC694\uC998
      \uADF8\uB807\uAC8C \uC798 \uD314\uB9B0\uB300\uC694. \uC800\uB3C4 \uB450 \uAC1C
      \uC0C0\uC5B4\uC694. \uC544 \uCC38, \uC81C\uAC00 \uC694\uC0C8 \uC880 \uC774\uC0C1\uD574\uC694.
      <sym>\uC800\uC6B8\uC5D0 \uC62C\uB77C\uAC00\uB3C4 \uBC14\uB298\uC774 \uAC70\uC758
      \uC548 \uC6C0\uC9C1\uC5EC\uC694</sym>. \uAC78\uC744 \uB54C\uB3C4 <sym>\uBC1C\uB4A4\uAFC8\uCE58\uAC00
      \uBC14\uB2E5\uC5D0 \uC548 \uB2FF\uACE0\uC694</sym>. <sym>\uBC14\uB78C \uBD80\uB294
      \uB0A0\uC5D4 \uBB38\uACE0\uB9AC\uB97C \uAF2D \uBD99\uC7A1\uACE0 \uC788\uC5B4\uC57C
      \uD574\uC694</sym>. \uB2E4\uC74C \uC8FC\uC5D0 \uC870\uCE74 \uACB0\uD63C\uC2DD\uC778\uB370
      \uD070\uC77C\uC774\uC5D0\uC694. \uD558\uAC1D\uC774 \uB0A0\uC544\uAC00\uBA74
      \uC548 \uB418\uC796\uC544\uC694."
  - key: sym_DIS_04
    kind: 0
    diseaseId: DIS_04
    conditionText: "\uC9C8\uBCD1\uC774 DIS_04"
    targetLength: "200\uC790 \uB0B4\uC678"
    text: "\uC694\uC998 \uC606\uC9D1\uC5D0\uC11C \uBC24\uB9C8\uB2E4 \uD53C\uB9AC\uB97C
      \uBD88\uC5B4\uC694. \uBB34\uC2A8 \uACE1\uC778\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4\uC694.
      \uADF8\uAC83\uB3C4 \uACE8\uCE58\uC778\uB370 \uB354 \uC774\uC0C1\uD55C \uC77C\uC774
      \uC788\uC5B4\uC694. \uC544\uCE68\uC5D0 \uBA38\uB9AC\uB97C \uBE57\uC73C\uB824\uACE0
      \uAC70\uC6B8\uC744 \uBD24\uB354\uB2C8 <sym>\uAC70\uC6B8 \uC18D \uC81C\uAC00
      \uAFB8\uBC85\uAFB8\uBC85 \uC878\uACE0 \uC788\uB354\uB77C\uACE0\uC694</sym>.
      \uADF8\uB7F0\uB370 <sym>\uC815\uC791 \uC800\uB294 \uBC24\uC0C8 \uB208\uC774
      \uB9D0\uB625\uB9D0\uB625\uD574\uC694</sym>. \uD53C\uB9AC \uB54C\uBB38\uC778
      \uC904 \uC54C\uC558\uB294\uB370 \uC544\uB2C8\uC5C8\uC5B4\uC694. \uC5B4\uC81C\uB294
      <sym>\uAC70\uC6B8 \uC18D\uC5D0\uC11C \uD558\uD488\uC744 \uD558\uB294 \uAC70\uC608\uC694.
      \uC800\uB294 \uC548 \uD588\uB294\uB370\uC694</sym>. \uADF8 \uB140\uC11D\uC774
      \uC800 \uB300\uC2E0 \uD479 \uC790\uB098 \uBD10\uC694."
  - key: sym_DIS_05
    kind: 0
    diseaseId: DIS_05
    conditionText: "\uC9C8\uBCD1\uC774 DIS_05"
    targetLength: "200\uC790 \uB0B4\uC678"
    text: "\uB2E4\uC74C \uB2EC \uCD95\uC81C \uB54C \uD30C\uC774 \uB300\uD68C \uC5F4\uB9AC\uB294
      \uAC70 \uC544\uC2DC\uC8E0? \uB3D9\uB124 \uC0AC\uB78C\uB4E4\uC774 \uB2E4 \uB098\uAC04\uB2E4\uACE0
      \uB09C\uB9AC\uC608\uC694. \uADFC\uB370 \uC800 \uD070\uC77C \uB0AC\uC5B4\uC694.
      <sym>\uBB58 \uBA39\uC5B4\uB3C4 \uCC98\uB9C8 \uBC11\uC5D0 \uBC1B\uC544 \uB454
      \uBB3C \uB9DB\uC774 \uB098\uC694</sym>. \uAFC0\uC744 \uD37C\uBA39\uC5B4\uB3C4\uC694.
      \uADF8\uB9AC\uACE0 <sym>\uB0A0\uC774 \uAFB8\uBB3C\uAFB8\uBB3C\uD558\uAE30 \uC804\uB0A0\uC5D4
      \uD600\uB05D\uC774 \uCC0C\uB9BF\uCC0C\uB9BF\uD574\uC694</sym>. \uB355\uBD84\uC5D0
      \uBE68\uB798 \uAC77\uC744 \uB54C\uB294 \uAE30\uAC00 \uB9C9\uD788\uAC8C \uB9DE\uD600\uC694.
      \uC694\uC998\uC740 <sym>\uC785 \uC548\uC5D0\uC11C \uBE44 \uC628 \uB4A4 \uB9C8\uB2F9
      \uB0C4\uC0C8\uAE4C\uC9C0 \uB098\uC694</sym>. \uC774\uAC74 \uBE44\uBC00\uC778\uB370,
      \uC62C\uD574\uB294 \uC800\uB3C4 \uC0AC\uACFC\uD30C\uC774\uB85C \uB098\uAC00\uC694."
  - key: sym_DIS_06
    kind: 0
    diseaseId: DIS_06
    conditionText: "\uC9C8\uBCD1\uC774 DIS_06"
    targetLength: "200\uC790 \uB0B4\uC678"
    text: "\uC774\uAC83 \uC880 \uB9CC\uC838 \uBCF4\uC138\uC694. \uC544, \uC544\uB2C8\uB2E4,
      \uB9CC\uC9C0\uC9C0 \uB9C8\uC138\uC694. <sym>\uC81C \uC190\uB05D\uC774 \uB298
      \uC5BC\uC74C\uC7A5 \uAC19\uAC70\uB4E0\uC694</sym>. \uC7A5\uAC11\uC744 \uC138
      \uACB9\uC774\uB098 \uAF08\uB294\uB370\uB3C4 \uC18C\uC6A9\uC5C6\uC5B4\uC694.
      \uC778\uC0AC\uD558\uB2E4 \uC190\uC774\uB77C\uB3C4 \uC7A1\uC73C\uBA74 \uB2E4\uB4E4
      \uAE5C\uC9DD \uB180\uB77C\uC694. <sym>\uBB3C\uCEF5\uC744 \uB4E4\uBA74 \uAC89\uC5D0
      \uD558\uC597\uAC8C \uC5BC\uC74C\uAF43\uC774 \uB07C\uACE0\uC694</sym>, <sym>\uC544\uCE68\uC5D0
      \uC77C\uC5B4\uB098\uBA74 \uC774\uBD88 \uB05D\uC774 \uBEE3\uBEE3\uD558\uAC8C
      \uC5BC\uC5B4 \uC788\uC5B4\uC694</sym>. \uC5EC\uB984\uC5D4 \uADF8\uB798\uB3C4
      \uC88B\uC558\uC5B4\uC694. \uB2E4\uB4E4 \uC2DC\uC6D0\uD558\uB2E4\uACE0 \uC81C
      \uC606\uC5D0\uB9CC \uBD99\uC5B4 \uC788\uC5C8\uAC70\uB4E0\uC694. \uC9C0\uAE08\uC740
      \uB2E4\uB4E4 \uC2AC\uAE08\uC2AC\uAE08 \uD53C\uD574 \uB2E4\uB140\uC694."
  - key: rcv_ok
    kind: 1
    diseaseId: 
    conditionText: "\uBCD1\uACFC \uC789\uD06C \uBAA8\uB450 \uB9DE\uC74C"
    targetLength: "30~60\uC790"
    text: "\uC5B4\uBA38, \uBCD1\uB3C4 \uC608\uC058\uACE0 \uAE00\uC528\uB3C4 \uC798
      \uBCF4\uC774\uB124\uC694. \uACE0\uB9C8\uC6CC\uC694. \uBC14\uB85C \uB9C8\uC154
      \uBCFC\uAC8C\uC694."
  - key: rcv_bottle
    kind: 1
    diseaseId: 
    conditionText: "\uBCD1\uB9CC \uD2C0\uB9BC"
    targetLength: "30~60\uC790"
    text: "\uC774 \uBCD1\uC740 \uC880... \uC81C \uCDE8\uD5A5\uC740 \uC544\uB2C8\uB124\uC694.
      \uBB50, \uC57D\uB9CC \uC798 \uB4E4\uC73C\uBA74 \uB410\uC8E0."
  - key: rcv_ink
    kind: 1
    diseaseId: 
    conditionText: "\uC789\uD06C\uB9CC \uD2C0\uB9BC (\uB77C\uBCA8\uC744 \uBABB \uC77D\uC74C)"
    targetLength: "30~60\uC790"
    text: "\uBCD1\uC740 \uB9C8\uC74C\uC5D0 \uB4DC\uB294\uB370, \uC774\uAC74 \uBB34\uC2A8
      \uAE00\uC790\uC8E0? \uD558\uB098\uB3C4 \uBABB \uC77D\uACA0\uC5B4\uC694. \uC77C\uB2E8
      \uB9C8\uC2E4\uAC8C\uC694."
  - key: rcv_both
    kind: 1
    diseaseId: 
    conditionText: "\uBCD1\uACFC \uC789\uD06C \uBAA8\uB450 \uD2C0\uB9BC"
    targetLength: "30~60\uC790"
    text: "\uBCD1\uB3C4 \uC774\uC0C1\uD558\uACE0 \uAE00\uC528\uB294 \uC77D\uC9C0\uB3C4
      \uBABB\uD558\uACA0\uACE0... \uC774\uAC70 \uC815\uB9D0 \uC81C \uC57D \uB9DE\uC544\uC694?
      \uC77C\uB2E8 \uB9C8\uC154 \uBCFC\uAC8C\uC694."
  - key: aft_cured
    kind: 2
    diseaseId: 
    conditionText: "\uC7AC\uB8CC 3\uAC1C \uBAA8\uB450 \uB9DE\uACE0 \uC789\uD06C\uB3C4
      \uB9DE\uC74C"
    targetLength: "40~80\uC790"
    text: "\uC5B4? \uBC29\uAE08 \uBB54\uAC00 \uC465 \uB0B4\uB824\uAC00\uB294 \uB290\uB08C\uC774
      \uB0AC\uC5B4\uC694. \uC9C4\uC9DC \uB098\uC558\uB098 \uBD10\uC694! \uACE0\uB9C8\uC6CC\uC694.
      \uB3D9\uB124\uBC29\uB124 \uC18C\uBB38\uB0BC\uAC8C\uC694."
  - key: aft_cured_ink
    kind: 2
    diseaseId: 
    conditionText: "\uC7AC\uB8CC\uB294 \uBAA8\uB450 \uB9DE\uC558\uC9C0\uB9CC \uC789\uD06C\uAC00
      \uD2C0\uB9BC"
    targetLength: "40~80\uC790"
    text: "\uB2E4 \uB098\uC740 \uAC83 \uAC19\uAE34 \uD574\uC694. \uADF8\uB7F0\uB370
      \uC57D\uC740 \uC798 \uC9C0\uC73C\uC2DC\uBA74\uC11C \uB77C\uBCA8\uC740 \uC65C
      \uADF8\uB807\uAC8C \uC4F0\uC168\uC5B4\uC694? \uB2E4\uC74C\uC5D4 \uC77D\uC744
      \uC218 \uC788\uAC8C \uC368 \uC8FC\uC138\uC694."
  - key: aft_odd
    kind: 2
    diseaseId: 
    conditionText: "\uC7AC\uB8CC\uAC00 1\uAC1C \uD2C0\uB9BC (\uBAB8 \uC0C9\uC774
      \uBCC0\uD568)"
    targetLength: "40~80\uC790"
    text: "\uC74C, \uB9DB\uC774 \uC880 \uC774\uC0C1\uD55C\uB370\uC694? \uC5B4, \uC81C
      \uC190\uC774 \uC65C \uC774\uB7F0 \uC0C9\uC774\uC8E0? \uC774\uAC70 \uC6D0\uB798
      \uC774\uB807\uAC8C \uB418\uB294 \uAC70 \uB9DE\uC544\uC694?"
  - key: aft_slime
    kind: 2
    diseaseId: 
    conditionText: "\uC7AC\uB8CC\uAC00 2\uAC1C \uC774\uC0C1 \uD2C0\uB9BC (\uC2AC\uB77C\uC784\uC774
      \uB428)"
    targetLength: "40~80\uC790"
    text: "\uC7A0\uAE50\uB9CC\uC694, \uBAB8\uC774 \uC65C \uC774\uB807\uAC8C \uBB3C\uB801\uBB3C\uB801...
      \uC774\uAC8C \uBB50\uC608\uC694! \uC800 \uC2AC\uB77C\uC784\uC774 \uB410\uC796\uC544\uC694!
      \uB2F9\uC7A5 \uB3CC\uB824\uB194\uC694!"
  - key: timeout
    kind: 3
    diseaseId: 
    conditionText: "\uC81C\uD55C \uC2DC\uAC04\uC774 \uB05D\uB0A8 (\uC7AC\uB8CC, \uBCD1,
      \uC789\uD06C \uBAA8\uB450 0\uC810)"
    targetLength: "40~80\uC790"
    text: "\uB410\uC5B4\uC694, \uB354\uB294 \uBABB \uAE30\uB2E4\uB9AC\uACA0\uC5B4\uC694.
      \uC57D \uD558\uB098 \uC9D3\uB294 \uB370 \uC774\uB807\uAC8C \uC624\uB798 \uAC78\uB824\uC11C\uC57C
      \uC6D0. \uB2E4\uB978 \uAC00\uAC8C\uB85C \uAC08\uB798\uC694!"
