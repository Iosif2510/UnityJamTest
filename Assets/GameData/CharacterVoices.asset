  m_Script: {fileID: 11500000, guid: fe7c2f9f440bd6e4c9f0f058c13bc0a5, type: 3}
  m_Name: CharacterVoices
  m_EditorClassIdentifier: Assembly-CSharp::PotionShop.Data.CharacterVoiceCatalog
  voices:
  - code: HUM_M1
    displayName: "\uD1A0\uBE44"
    speechStyle: "\uD574\uC694\uCCB4. \uB9D0\uB05D\uC744 \"~\uAC70\uB4E0\uC694...\"
      \uD558\uACE0 \uD750\uB9AC\uACE0, \"\uC544, \uC544\uB2C8\uC5D0\uC694\" \uD558\uBA70
      \uC790\uC8FC \uB9D0\uC744 \uACE0\uCE5C\uB2E4"
    personality: "\uC22B\uAE30\uAC00 \uC5C6\uC9C0\uB9CC \uC1E0 \uB2E4\uB8E8\uB294
      \uC774\uC57C\uAE30\uB9CC \uB098\uC624\uBA74 \uB9D0\uC774 \uB9CE\uC544\uC9C4\uB2E4"
    chatTopics:
    - "\uCC98\uC74C \uD63C\uC790 \uB9CC\uB4E0 \uD3B8\uC790"
    - "\uBB34\uC11C\uC6B4 \uB300\uC7A5\uC7A5\uC774 \uC2A4\uC2B9"
    - "\uC190\uBC14\uB2E5 \uBB3C\uC9D1"
  - code: HUM_M2
    displayName: "\uD55C\uC2A4"
    speechStyle: "\uD574\uC694\uCCB4. \"\uADF8\uAC8C \uB9D0\uC774\uC8E0\"\uB85C \uB9D0\uC744
      \uAEBC\uB0B4\uACE0 \uC774\uC57C\uAE30\uAC00 \uC790\uAFB8 \uC606\uAE38\uB85C
      \uC0CC\uB2E4"
    personality: "\uB3D9\uB124 \uC18C\uBB38\uC744 \uB2E4 \uAFF0\uACE0 \uC788\uACE0
      \uB0A8 \uC598\uAE30\uB97C \uC88B\uC544\uD55C\uB2E4"
    chatTopics:
    - "\uACE8\uBAA9\uB9C8\uB2E4 \uB2E4\uB978 \uB4F1\uBD88 \uAE30\uB984"
    - "\uBC24\uC5D0 \uBCF8 \uC218\uC0C1\uD55C \uC0AC\uB78C"
    - "\uC544\uB0B4 \uC790\uB791"
  - code: HUM_M3
    displayName: "\uBE0C\uB8E8\uB178"
    speechStyle: "\uC9E7\uAC8C \uB04A\uB294 \uD558\uC624\uCCB4. \"\uB410\uC18C\",
      \"\uADF8\uB807\uC18C\""
    personality: "\uB9D0\uC218\uAC00 \uC801\uACE0 \uD241\uBA85\uC2A4\uB7FD\uC9C0\uB9CC
      \uD560 \uB9D0\uC740 \uB2E4 \uD55C\uB2E4"
    chatTopics:
    - "\uAC15 \uBB3C\uC0B4"
    - "\uD558\uB298 \uBCF4\uACE0 \uB0A0\uC528 \uB9DE\uD788\uAE30"
    - "\uBC43\uC0AF \uC548 \uB0B4\uACE0 \uB2EC\uC544\uB09C \uC190\uB2D8"
  - code: HUM_F1
    displayName: "\uD074\uB77C\uB77C"
    speechStyle: "\uB610\uBC15\uB610\uBC15\uD55C \uD574\uC694\uCCB4. \"\uC815\uD655\uD788
      \uB9D0\uC500\uB4DC\uB9AC\uBA74\"\uC744 \uC790\uC8FC \uC4F4\uB2E4"
    personality: "\uAF3C\uAF3C\uD558\uACE0 \uC815\uB9AC \uC548 \uB41C \uAC83\uC744
      \uBABB \uCC38\uB294\uB2E4"
    chatTopics:
    - "\uBC18\uB0A9 \uC548 \uB41C \uCC45"
    - "\uB4A4\uC8FD\uBC15\uC8FD\uB41C \uCC45\uC7A5"
    - "\uB3C4\uC11C\uAD00\uC5D0\uC11C \uB5A0\uB4DC\uB294 \uC0AC\uB78C"
  - code: HUM_F2
    displayName: "\uBAB0\uB9AC"
    speechStyle: "\"\uC138\uC0C1\uC5D0\"\uB85C \uC2DC\uC791\uD558\uB294 \uBC18\uB9D0
      \uC11E\uC778 \uC874\uB313\uB9D0. \uC0C1\uB300\uB97C \"\uC8FC\uC778\uC7A5\"\uC774\uB77C
      \uBD80\uB978\uB2E4"
    personality: "\uC815\uC774 \uB9CE\uACE0 \uB204\uAD6C\uC5D0\uAC8C\uB098 \uBA39\uC744
      \uAC83\uC744 \uAD8C\uD55C\uB2E4"
    chatTopics:
    - "\uC624\uB298 \uAD6C\uC6B4 \uD30C\uC774"
    - "\uBC00\uAC00\uB8E8 \uAC12"
    - "\uB9D0 \uB9CE\uC740 \uB2E8\uACE8"
  - code: HUM_F3
    displayName: "\uADF8\uB808\uD0C0"
    speechStyle: "\uC2DC\uC6D0\uD558\uAC8C \uB04A\uB294 \uD574\uC694\uCCB4. \uB9D0
      \uC911\uAC04\uC5D0 \"\uD558\uD558\" \uC6C3\uB294\uB2E4"
    personality: "\uD138\uD138\uD558\uACE0 \uAC81\uC774 \uC5C6\uB2E4. \uBC8C\uC5D0
      \uC3D8\uC778 \uAC78 \uC790\uB791\uD55C\uB2E4"
    chatTopics:
    - "\uBC8C\uD1B5"
    - "\uC62C\uD574 \uAFC0\uB9DB"
    - "\uBC8C\uC5D0 \uC3D8\uC778 \uD69F\uC218"
  - code: ELF_M1
    displayName: "\uC138\uB80C"
    speechStyle: "\uB290\uB9BF\uD558\uAC8C \uB298\uC5B4\uC9C0\uB294 \uD574\uC694\uCCB4.
      \uAC00\uB054 \uC989\uD765 \uC2DC\uAD6C\uB97C \uC74A\uB294\uB2E4"
    personality: "\uAC8C\uC73C\uB974\uACE0 \uB0AD\uB9CC\uC801\uC774\uBA70 \uB3C8
      \uAC1C\uB150\uC774 \uC5C6\uB2E4"
    chatTopics:
    - "\uB5A0\uB3CC\uBA70 \uC9C0\uB098\uC628 \uB9C8\uC744"
    - "\uC220\uC9D1 \uACF5\uC5F0"
    - "\uC904 \uB04A\uC5B4\uC9C4 \uB958\uD2B8"
  - code: ELF_M2
    displayName: "\uD0C8\uB9AC\uC624"
    speechStyle: "\uD574\uC694\uCCB4. \uC2DC\uAC04\uC744 \uBD84 \uB2E8\uC704\uB85C
      \uB9D0\uD55C\uB2E4(\"\uC815\uD655\uD788 \uC5F4\uD55C \uC2DC \uC0AC\uC2ED \uBD84\uC5D0\")"
    personality: "\uC57D\uC18D\uC5D0 \uC608\uBBFC\uD558\uACE0 \uB2A6\uB294 \uC0AC\uB78C\uC744
      \uC2EB\uC5B4\uD55C\uB2E4"
    chatTopics:
    - "\uACE0\uCE58\uB2E4 \uB9CC \uAD18\uC885\uC2DC\uACC4"
    - "\uD1B1\uB2C8\uBC14\uD034"
    - "\uB2A6\uAC8C \uCC3E\uC544\uC624\uB294 \uC190\uB2D8"
  - code: ELF_M3
    displayName: "\uBCA0\uB978"
    speechStyle: "\uC9E7\uC740 \uD558\uAC8C\uCCB4. \"\uADF8\uB807\uB124\", \"\uC54C\uACA0\uB124\".
      \uBB38\uC7A5 \uC0AC\uC774\uAC00 \uAE38\uB2E4"
    personality: "\uC0AC\uB78C\uBCF4\uB2E4 \uB098\uBB34\uB97C \uD3B8\uD558\uAC8C
      \uC5EC\uAE34\uB2E4"
    chatTopics:
    - "\uC232\uC758 \uC624\uB798\uB41C \uB098\uBB34"
    - "\uBC00\uB835\uAFBC"
    - "\uC0AC\uC2B4 \uAC00\uC871"
  - code: ELF_F1
    displayName: "\uB2C8\uC544"
    speechStyle: "\uD574\uC694\uCCB4. \uB9D0\uD558\uB2E4\uAC00 \"\uADF8\uAC74 \uBB50\uC608\uC694?\",
      \"\uC65C\uC694?\" \uD558\uACE0 \uB418\uBB3B\uB294\uB2E4"
    personality: "\uD638\uAE30\uC2EC\uC774 \uB9CE\uC544 \uACF5\uBC29 \uBB3C\uAC74\uC744
      \uC774\uAC83\uC800\uAC83 \uAD81\uAE08\uD574\uD55C\uB2E4"
    chatTopics:
    - "\uCC98\uC74C \uBCF4\uB294 \uAF43"
    - "\uAF43\uB9D0"
    - "\uC8FC\uC778 \uBAB0\uB798 \uD0A4\uC6B0\uB294 \uD654\uBD84"
  - code: ELF_F2
    displayName: "\uB85C\uC81C\uD0C0"
    speechStyle: "\uC6B0\uC544\uD55C \uD558\uC2ED\uC2DC\uC624\uCCB4. \uC0C1\uB300\uC758
      \uC637\uCC28\uB9BC\uC744 \uD55C\uB9C8\uB514\uC529 \uD3C9\uD55C\uB2E4"
    personality: "\uD488\uC704\uB97C \uC911\uC2DC\uD558\uACE0 \uBC14\uB290\uC9C8
      \uC19C\uC528\uC5D0 \uC790\uBD80\uC2EC\uC774 \uC788\uB2E4"
    chatTopics:
    - "\uADC0\uC871 \uC190\uB2D8\uC758 \uB4DC\uB808\uC2A4"
    - "\uC637\uAC10 \uACE0\uB974\uAE30"
    - "\uCD0C\uC2A4\uB7EC\uC6B4 \uC637"
  - code: ELF_F3
    displayName: "\uD558\uC77C\uB77C"
    speechStyle: "\uBC18\uB9D0 \uC11E\uC778 \uAC70\uCE5C \uD574\uC694\uCCB4. \"\uC5D0\uB77C\uC774\",
      \"\uADF8\uB0E5 \uB9D0\uC774\uC57C\""
    personality: "\uD138\uD138\uD558\uACE0 \uB9D0\uC744 \uAC00\uC871\uCC98\uB7FC
      \uC544\uB080\uB2E4"
    chatTopics:
    - "\uB9C8\uCC28 \uBC14\uD034"
    - "\uB9D0 \uC774\uB984"
    - "\uD5D8\uD55C \uACE0\uAC2F\uAE38"
  - code: BST_M1
    displayName: "\uD3A0\uB9AD\uC2A4"
    speechStyle: "\uBE60\uB974\uACE0 \uC9E7\uC740 \uD574\uC694\uCCB4. \"\uBE68\uB9AC\uC694,
      \uBE68\uB9AC\" \uD558\uACE0 \uC7AC\uCD09\uD55C\uB2E4"
    personality: "\uC131\uBBF8\uAC00 \uAE09\uD558\uACE0 \uB298 \uB2E4\uC74C \uBC30\uB2EC\uC744
      \uAC71\uC815\uD55C\uB2E4"
    chatTopics:
    - "\uC624\uB298 \uBC30\uB2EC\uD560 \uD3B8\uC9C0"
    - "\uAC1C \uC9D6\uB294 \uC9D1"
    - "\uC9C0\uBD95 \uC704 \uC9C0\uB984\uAE38"
  - code: BST_M2
    displayName: "\uB808\uB098\uB974"
    speechStyle: "\uB2A5\uAE00\uB9DE\uC740 \uC874\uB313\uB9D0. \uB9D0\uB05D\uB9C8\uB2E4
      \uBB3C\uAC74\uC744 \uD314\uB824\uACE0 \uD55C\uB2E4"
    personality: "\uB2A5\uCCAD\uC2A4\uB7FD\uACE0 \uC190\uD574 \uBCF4\uB294 \uAC78
      \uC2EB\uC5B4\uD55C\uB2E4"
    chatTopics:
    - "\uBCF4\uB530\uB9AC \uC18D \uC7A1\uB3D9\uC0AC\uB2C8"
    - "\uAC12 \uAE4E\uB294 \uC190\uB2D8"
    - "\uBA3C \uB3C4\uC2DC\uC758 \uC9C4\uADC0\uD55C \uBB3C\uAC74"
  - code: BST_M3
    displayName: "\uC6B0\uB974\uC2A4"
    speechStyle: "\uB290\uB9AC\uACE0 \uC21C\uD55C \uD574\uC694\uCCB4. \"\uC74C...\"\uC73C\uB85C
      \uB9D0\uC744 \uC2DC\uC791\uD55C\uB2E4"
    personality: "\uC21C\uD558\uACE0 \uB290\uAE0B\uD558\uBA70 \uB0A8\uC744 \uC798
      \uB3D5\uB294\uB2E4"
    chatTopics:
    - "\uB9CC\uB4E4\uACE0 \uC788\uB294 \uD754\uB4E4\uC758\uC790"
    - "\uAFC0"
    - "\uAC13 \uCF20 \uB098\uBB34 \uB0C4\uC0C8"
  - code: BST_F1
    displayName: "\uD3EC\uD53C"
    speechStyle: "\uC791\uC740 \uBAA9\uC18C\uB9AC. \uB9D0\uC744 \uB354\uB4EC\uACE0
      \"\uC8C4, \uC8C4\uC1A1\uD574\uC694\"\uB97C \uC790\uC8FC \uD55C\uB2E4"
    personality: "\uAC81\uC774 \uB9CE\uC544 \uC791\uC740 \uC18C\uB9AC\uC5D0\uB3C4
      \uB180\uB780\uB2E4"
    chatTopics:
    - "\uCC3B\uC78E \uACE0\uB974\uAE30"
    - "\uBB34\uC11C\uC6B4 \uB2E8\uACE8\uC190\uB2D8"
    - "\uCC3B\uC794 \uAE6C \uC77C"
  - code: BST_F2
    displayName: "\uB9C8\uB4E4\uB80C"
    speechStyle: "\uB9D0\uB05D\uC744 \uB298\uC774\uB294 \uBC18\uB9D0 \uC11E\uC778
      \uD574\uC694\uCCB4"
    personality: "\uADC0\uCC2E\uC740 \uAC74 \uC2EB\uC5B4\uD558\uC9C0\uB9CC \uBE75
      \uB9DB\uC5D0\uB294 \uAE4C\uB2E4\uB86D\uB2E4"
    chatTopics:
    - "\uC0C8\uBCBD \uBC18\uC8FD"
    - "\uBCD5 \uB4DC\uB294 \uCC3D\uAC00"
    - "\uBE75 \uD6D4\uCCD0 \uBA39\uB294 \uC950"
  - code: BST_F3
    displayName: "\uB8E8\uD30C"
    speechStyle: "\uB531\uB531\uD55C \uD558\uC2ED\uC2DC\uC624\uCCB4. \"\uBCF4\uACE0\uB4DC\uB9AC\uC790\uBA74\"\uC73C\uB85C
      \uB9D0\uC744 \uAEBC\uB0B8\uB2E4"
    personality: "\uB2F9\uB2F9\uD558\uACE0 \uADDC\uCE59\uC744 \uC911\uC2DC\uD55C\uB2E4"
    chatTopics:
    - "\uC131\uBB38 \uACBD\uBE44"
    - "\uC220 \uCDE8\uD55C \uD589\uC778"
    - "\uB9D0 \uC548 \uB4E3\uB294 \uC2E0\uCC38"
  - code: GOL_G1
    displayName: "\uD398\uBE14"
    speechStyle: "\uC544\uC774 \uAC19\uC740 \uC9E7\uC740 \uBC18\uB9D0. \uC790\uAE30\uB97C
      \"\uD398\uBE14\"\uC774\uB77C\uACE0 \uBD80\uB978\uB2E4"
    personality: "\uCC9C\uC9C4\uD558\uACE0 \uC791\uC740 \uAC83\uC5D0\uB3C4 \uAE30\uBED0\uD55C\uB2E4"
    chatTopics:
    - "\uD0A4\uC6B0\uB294 \uC0C8\uC2F9"
    - "\uB2EC\uD33D\uC774 \uCE5C\uAD6C"
    - "\uBB3C\uBFCC\uB9AC\uAC1C"
  - code: GOL_G2
    displayName: "\uBAA8\uC2A4"
    speechStyle: "\uC544\uC8FC \uB290\uB9B0 \uD558\uC624\uCCB4. \uC61B\uB0A0 \uC77C\uC744
      \uC5B4\uC81C \uC77C\uCC98\uB7FC \uB9D0\uD55C\uB2E4"
    personality: "\uC624\uB798 \uC0B0 \uB9CC\uD07C \uB290\uAE0B\uD558\uACE0 \uCC38\uC744\uC131\uC774
      \uB9CE\uB2E4"
    chatTopics:
    - "\uB2E4\uB9AC\uB97C \uAC74\uB108\uB294 \uC0AC\uB78C\uB4E4"
    - "\uBAB8\uC5D0 \uC790\uB780 \uC774\uB07C"
    - "\uBC31 \uB144 \uC804 \uD070\uBB3C"
  - code: GOL_G3
    displayName: "\uCFFC\uCE20"
    speechStyle: "\uB610\uB791\uB610\uB791\uD55C \uD574\uC694\uCCB4. \uC22B\uC790\uC640
      \uBC29\uD5A5\uC744 \uC815\uD655\uD788 \uB9D0\uD55C\uB2E4(\"\uC67C\uCABD \uC138
      \uBC88\uC9F8 \uAD74\")"
    personality: "\uAE38 \uC783\uC740 \uC0AC\uB78C\uC744 \uADF8\uB0E5 \uC9C0\uB098\uCE58\uC9C0
      \uBABB\uD55C\uB2E4"
    chatTopics:
    - "\uAD11\uC0B0 \uAC31\uB3C4"
    - "\uAE38 \uC783\uC740 \uAD11\uBD80"
    - "\uC5B4\uB460 \uC18D\uC5D0\uC11C \uBE5B\uB098\uB294 \uBAB8"
  - code: GOL_G4
    displayName: "\uBCFC\uB354"
    speechStyle: "\uD55C \uB2E8\uC5B4\uC529 \uB04A\uB294 \uBC18\uB9D0. \"\uC9D0.
      \uBB34\uAC70\uC6CC. \uAD1C\uCC2E\uC544.\""
    personality: "\uD798\uC138\uACE0 \uB2E8\uC21C\uD558\uBA70 \uCE6D\uCC2C\uC5D0
      \uC57D\uD558\uB2E4"
    chatTopics:
    - "\uC624\uB298 \uB098\uB978 \uC9D0"
    - "\uBD80\uC11C\uC9C4 \uC218\uB808"
    - "\uD798\uC790\uB791"
