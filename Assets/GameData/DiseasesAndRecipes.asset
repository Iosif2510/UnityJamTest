  diseases:
  - id: disease.shadow_lag
    status: 1
    displayName: "\uC9C0\uC5F0 \uADF8\uB9BC\uC790\uBCD1"
    recipeId: recipe.shadow_lag
    dialogue:
    - segments:
      - text: "\uC624\uB298 \uC7A5\uC5D0 \uC0AC\uB78C\uB4E4\uC774 \uB9CE\uB354\uB77C\uACE0\uC694.
          \uADF8\uB7F0\uB370 \uC694\uC998 "
        isSymptom: 0
      - text: "\uADF8\uB9BC\uC790\uAC00 \uBA87 \uAC78\uC74C \uB4A4\uC5D0 \uB530\uB77C\uC640\uC694."
        isSymptom: 1
  - id: disease.shadow_rush
    status: 1
    displayName: "\uC870\uAE09 \uADF8\uB9BC\uC790\uBCD1"
    recipeId: recipe.shadow_rush
    dialogue:
    - segments:
      - text: "\uC624\uB298 \uC7A5\uC5D0 \uC0AC\uB78C\uB4E4\uC774 \uB9CE\uB354\uB77C\uACE0\uC694.
          \uADF8\uB7F0\uB370 \uC694\uC998 "
        isSymptom: 0
      - text: "\uADF8\uB9BC\uC790\uAC00 \uC81C\uAC00 \uC6C0\uC9C1\uC774\uAE30 \uC804\uC5D0
          \uBA3C\uC800 \uB2EC\uB824\uAC00\uC694."
        isSymptom: 1
  - id: disease.ember_spots
    status: 1
    displayName: "\uBD88\uC528 \uBC18\uC810\uBCD1"
    recipeId: recipe.ember_spots
    dialogue:
    - segments:
      - text: "\uC544\uCE68\uBD80\uD130 \uC7A5\uC5D0 \uB2E4\uB140\uC624\uB290\uB77C
          \uC815\uC2E0\uC774 \uC5C6\uC5C8\uC5B4\uC694. \uADF8\uB7F0\uB370\uC694, "
        isSymptom: 0
      - text: "\uD314\uC5D0 \uB09C \uBC18\uC810\uC774 \uC5F4\uC744 \uBC1B\uC73C\uBA74
          \uBE68\uAC1B\uAC8C \uBE5B\uB098\uC694."
        isSymptom: 1
    - segments:
      - text: "\uC624\uB298\uC740 \uB0A0\uC528\uAC00 \uCC38 \uBCC0\uB355\uC2A4\uB7FD\uB124\uC694.
          \uC694 \uBA70\uCE60 "
        isSymptom: 0
      - text: "\uD314\uC5D0 \uB09C \uBC18\uC810\uC774 \uC5F4\uC744 \uBC1B\uC73C\uBA74
          \uBE68\uAC1B\uAC8C \uBE5B\uB098\uC694."
        isSymptom: 1
  - id: disease.frost_spots
    status: 1
    displayName: "\uC11C\uB9AC \uBC18\uC810\uBCD1"
    recipeId: recipe.frost_spots
    dialogue:
    - segments:
      - text: "\uC544\uCE68\uBD80\uD130 \uC7A5\uC5D0 \uB2E4\uB140\uC624\uB290\uB77C
          \uC815\uC2E0\uC774 \uC5C6\uC5C8\uC5B4\uC694. \uADF8\uB7F0\uB370\uC694, "
        isSymptom: 0
      - text: "\uD314\uC5D0 \uB09C \uBC18\uC810\uC774 \uCD94\uC6B8 \uB54C\uB9CC \uD558\uC597\uAC8C
          \uBE5B\uB098\uC694."
        isSymptom: 1
    - segments:
      - text: "\uC624\uB298\uC740 \uB0A0\uC528\uAC00 \uCC38 \uBCC0\uB355\uC2A4\uB7FD\uB124\uC694.
          \uC694 \uBA70\uCE60 "
        isSymptom: 0
      - text: "\uD314\uC5D0 \uB09C \uBC18\uC810\uC774 \uCD94\uC6B8 \uB54C\uB9CC \uD558\uC597\uAC8C
          \uBE5B\uB098\uC694."
        isSymptom: 1
